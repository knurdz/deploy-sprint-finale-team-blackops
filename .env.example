# Copy to .env for local `docker compose up` runs. Never commit a real .env
# file (it is gitignored). Values below are placeholders only.
#
# The Compose project name itself is fixed via the `name:` key in
# docker-compose.yml (deploy-sprint-blackops), not read from this file.

# Image tag / release version to build and run (e.g. a git SHA).
APP_VERSION=

# Host port to publish the team-site container's port 80 on.
APP_PORT=
