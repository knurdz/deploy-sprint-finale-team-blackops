# Copy to .env.local for local development. Never commit real values.
# In CI/deploy, these are supplied as GitHub Actions vars/secrets, not files.

# Public URL of the deployed site. Exposed to the client bundle by Vite
# (VITE_ prefix), so it must never hold anything sensitive.
VITE_PUBLIC_URL=

# Web3Forms contact form access key (create at web3forms.com). Unlike other
# secrets in this repo, Web3Forms access keys are meant to be used from the
# browser — it's a form identifier tied to the receiving inbox, not a bearer
# credential — so shipping it in the client bundle via the VITE_ prefix is the
# intended usage. Still: never commit a real value here; in CI/deploy it is
# supplied from the WEB3FORMS_ACCESS_KEY GitHub secret.
VITE_WEB3FORMS_ACCESS_KEY=
